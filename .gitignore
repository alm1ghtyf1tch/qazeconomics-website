# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/
/test-results/
/playwright-report/
/blob-report/
/.playwright-cli/
/.playwright-mcp/
/.playwright/auth/
/playwright/.auth/
/tests/.auth/
/auth.json
/storage-state*.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# private credentials and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.npmrc
.netrc
.pgpass

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Keep real environment values local; commit only the blank root template.
.env*
!/.env.example

# local databases and Supabase CLI state (keep migrations and seed SQL)
*.db
*.sqlite
*.sqlite3
*.sql.gz
/supabase/.temp/
/supabase/.branches/

# vercel
.vercel/
.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts
